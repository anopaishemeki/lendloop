{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "assist": {
    "actions": {
      "source": {
        "useSortedPackageJson": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": ["!.claude", "!convex/_generated", "!n8n/workflows"]
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "style": {
        "noMagicNumbers": "off",
        "noNonNullAssertion": "off",
        "useBlockStatements": "off",
        "useConsistentTypeDefinitions": "off",
        "useNamingConvention": "off"
      },
      "suspicious": {
        "noConsole": "off",
        "noUnknownAtRules": "off",
        "useAwait": "off"
      },
      "performance": {
        "noJsxPropsBind": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "convex/**/*.test.ts",
        "convex/test.setup.ts",
        "tests/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off",
            "noAwaitInLoops": "off"
          },
          "suspicious": {
            "noFocusedTests": "error"
          }
        }
      }
    },
    {
      "includes": ["n8n/snippets/**"],
      "javascript": {
        "globals": ["$env", "$vars"]
      },
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": [
        "convex/**/*.ts",
        "!convex/functions.ts",
        "!convex/_generated/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "./_generated/server": {
                    "importNames": ["mutation", "internalMutation"],
                    "message": "Import mutation and internalMutation from ./functions so writes keep the admin counters current."
                  },
                  "../_generated/server": {
                    "importNames": ["mutation", "internalMutation"],
                    "message": "Import mutation and internalMutation from ./functions so writes keep the admin counters current."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
