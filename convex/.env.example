# Convex deployment variables. Convex does NOT read this file: set each value with
#   npx convex env set NAME value          (dev deployment)
#   npx convex env set --prod NAME value   (production deployment)

# Clerk Frontend API URL (Dashboard -> API keys), e.g. https://your-app.clerk.accounts.dev
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=

# Public URL of the web app, used for links in notification emails.
APP_URL=http://localhost:3000

# Convex -> n8n: the PRODUCTION webhook URL of "LendLoop - Request notifications"
# (https://<your-instance>.app.n8n.cloud/webhook/lendloop/request-events, not /webhook-test/).
N8N_REQUEST_WEBHOOK_URL=
# Signs requests Convex sends to n8n. Same value as the n8n Variable LENDLOOP_OUTBOUND_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_OUTBOUND_SECRET=
# n8n -> Convex: verifies requests from n8n to /n8n/overdue-loans and /n8n/reminders,
# and signs the overdue-loans response. Same value as the n8n Variable LENDLOOP_INBOUND_SECRET.
# Use a different value from N8N_OUTBOUND_SECRET.
N8N_INBOUND_SECRET=
