{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["./**/*"],
  /* `convex deploy` typechecks with this config, so test files are excluded to
     keep a test-only type error from blocking a deploy. */
  "exclude": ["./_generated", "./**/*.test.ts", "./test.setup.ts"]
}
