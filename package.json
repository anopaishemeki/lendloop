{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "description": "A neighborhood tool-lending board",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json && tsc --noEmit -p convex/tsconfig.json && tsc --noEmit -p convex/tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:convex": "vitest run --project convex",
    "test:unit": "vitest run --project unit",
    "check:n8n": "node scripts/check-n8n-exports.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.22",
    "@convex-dev/workpool": "^0.4.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "convex-helpers": "^0.1.133",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "0.0.66",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "ultracite": "8.1.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
}
