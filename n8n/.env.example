# Only for the optional local n8n in docker-compose.yml. On n8n Cloud, set these
# as n8n Variables instead (the Variables page; see n8n/README.md).

# Public base URL n8n uses to build production webhook URLs (e.g. your tunnel URL).
WEBHOOK_URL=http://localhost:5678/

# Workflow settings (same names as the n8n Cloud Variables)
LENDLOOP_CONVEX_SITE_URL=https://your-deployment.convex.site
LENDLOOP_OUTBOUND_SECRET=
LENDLOOP_INBOUND_SECRET=
RESEND_FROM=LendLoop <onboarding@resend.dev>
OPS_ALERT_EMAIL=
