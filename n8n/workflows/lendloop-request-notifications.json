    {
      "parameters": {
        "jsCode": "// One short email per event, using only fields in the minimized payload.\nconst p = $input.first().json.payload;\nconst who = p.recipient.firstName;\nconst other = p.counterpartFirstName;\nconst tool = p.toolName;\nconst dates = p.loan.startDate === p.loan.endDate\n  ? p.loan.startDate\n  : `${p.loan.startDate} to ${p.loan.endDate}`;\n\nconst copy = {\n  'request.created': [\n    `${other} would like to borrow your ${tool}`,\n    `${other} asked to borrow your ${tool} for ${dates}. Approve or decline it here:`,\n  ],\n  'request.approved': [\n    `Your request for ${tool} was approved`,\n    `${other} approved your request to borrow the ${tool} for ${dates}. Details:`,\n  ],\n  'request.declined': [\n    `Your request for ${tool} was declined`,\n    `Your request to borrow the ${tool} for ${dates} was declined. Find something else here:`,\n  ],\n  'request.cancelled': [\n    `A loan for ${tool} was cancelled`,\n    `The loan of the ${tool} for ${dates} was cancelled. See your loans here:`,\n  ],\n  'loan.returned': [\n    `Thanks for returning the ${tool}`,\n    `${other} marked the ${tool} as returned. Thanks for borrowing responsibly!`,\n  ],\n};\nconst [subject, intro] = copy[p.event] || [`LendLoop update about ${tool}`, 'See your loans here:'];\n\nreturn [{\n  json: {\n    eventId: p.eventId,\n    to: p.recipient.email,\n    subject,\n    text: `Hi ${who},\\n\\n${intro}\\n${p.appUrl}\\n\\n- LendLoop`,\n  },\n}];\n"
      },
      "id": "8b0a7c3e-1d2f-4a51-9b5e-0c6e5d1a2b08",
      "name": "Build email",
