    },
    {
      "parameters": {
        "jsCode": "// Convex retries a delivery until it gets a 2xx, so the same eventId can arrive\n// more than once. Remember handled ids (production executions only) for 7 days.\nconst KEEP_MS = 7 * 24 * 60 * 60 * 1000;\nconst store = $getWorkflowStaticData('global');\nstore.handled = store.handled || {};\nconst now = Date.now();\nfor (const [id, at] of Object.entries(store.handled)) {\n  if (now - at > KEEP_MS) delete store.handled[id];\n}\nconst { payload } = $input.first().json;\nreturn [{ json: { payload, duplicate: Boolean(store.handled[payload.eventId]) } }];\n"
      },
      "id": "8b0a7c3e-1d2f-4a51-9b5e-0c6e5d1a2b05",
      "name": "Already handled?",
      "type": "n8n-nodes-base.code",
