    {
      "parameters": {
        "jsCode": "// Mark the event handled only after the email was accepted by Resend.\nconst store = $getWorkflowStaticData('global');\nstore.handled = store.handled || {};\nconst { eventId } = $('Build email').first().json;\nstore.handled[eventId] = Date.now();\nreturn [{ json: { eventId, sent: true } }];\n"
      },
