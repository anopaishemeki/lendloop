        "options": {
          "rawBody": true
        }
      },
      "id": "8b0a7c3e-1d2f-4a51-9b5e-0c6e5d1a2b01",
      "name": "Request event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "5f1c2a7e-9d34-4b8a-a6e1-2c7d9f0b3e11"
    },
    {
      "parameters": {
        "jsCode": "// Verifies the HMAC from Convex before anything else runs. Secret: n8n Variable\n// LENDLOOP_OUTBOUND_SECRET (same value as Convex env N8N_OUTBOUND_SECRET).\nconst crypto = require('crypto');\n\nconst MAX_SKEW_SECONDS = 300;\nconst secret = $vars.LENDLOOP_OUTBOUND_SECRET;\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst timestamp = headers['x-lendloop-timestamp'];\nconst signature = headers['x-lendloop-signature'] || '';\n\n// Raw body (Webhook option \"Raw Body\") so we hash exactly the bytes Convex signed.\nlet raw;\ntry {\n  raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} catch (error) {\n  raw = JSON.stringify(item.json.body ?? {});\n}\n\nconst path = new URL(item.json.webhookUrl).pathname;\n\nfunction check() {\n  if (!secret) return 'not configured';\n  if (!timestamp || !signature.startsWith('v1=')) return 'missing signature';\n  const seconds = Number(timestamp);\n  if (!Number.isInteger(seconds)) return 'malformed timestamp';\n  if (Math.abs(Date.now() / 1000 - seconds) > MAX_SKEW_SECONDS) return 'stale';\n  const expected = crypto\n    .createHmac('sha256', secret)\n    .update(`${timestamp}.POST.${path}.${raw}`)\n    .digest();\n  const given = Buffer.from(signature.slice(3), 'hex');\n  if (given.length !== expected.length) return 'mismatch';\n  return crypto.timingSafeEqual(given, expected) ? null : 'mismatch';\n}\n\nconst reason = check();\nif (reason) {\n  return [{ json: { valid: false, reason } }];\n}\n\n// Pass on only the verified payload; headers and raw body stop here.\nreturn [{ json: { valid: true, payload: JSON.parse(raw) } }];\n"
      },
